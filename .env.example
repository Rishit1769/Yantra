# Copy to .env and replace every placeholder with generated secrets.
# Keep .env out of version control and restrict permissions to the deployment user.
POSTGRES_ADMIN_USER=yantra_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_SECRET
YANTRA_DB=yantra
YANTRA_MIGRATOR_USER=yantra_migrator
YANTRA_MIGRATOR_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_MIGRATOR_SECRET
YANTRA_APP_USER=yantra_app
YANTRA_APP_PASSWORD=REPLACE_WITH_A_THIRD_LONG_RANDOM_RUNTIME_SECRET
POSTGRES_HOST_PORT=55432
